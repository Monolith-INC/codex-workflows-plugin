{
  "mcpServers": {
    "agentic-orchestrator": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator/run_mcp_server.py"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}",
        "ORCHESTRATOR_SKILLS_DIR": "${CLAUDE_PLUGIN_ROOT}/skills"
      }
    },
    "workflow-integrations": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/integrations/run_gateway.py"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    }
  }
}
