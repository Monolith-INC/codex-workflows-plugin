{
  "mcpServers": {
    "azure-devops": {
      "command": "~/.nvm/versions/node/v24.18.0/bin/npx",
      "args": [
        "@azure-devops/mcp",
        "${AZURE_DEVOPS_ORG}"
      ]
    },
    "agentic-orchestrator": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/orchestrator/run_mcp_server.py"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}",
        "ORCHESTRATOR_SKILLS_DIR": "${CLAUDE_PLUGIN_ROOT}/skills"
      }
    }
  }
}
